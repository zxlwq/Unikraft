# 复制为 .env 后填写真实值。.env 不要提交、不要写进 md。

# 站长登录账号
USERNAME=admin
# 站长登录密码（必填，请设强密码）
PASSWORD=
# 存储类型：个人用固定 upstash（不要改成 kvrocks/redis，除非另起实例）
NEXT_PUBLIC_STORAGE_TYPE=upstash
# Upstash Redis 的 HTTPS ENDPOINT
UPSTASH_URL=https://xxxx.upstash.io
# Upstash Redis 的 TOKEN
UPSTASH_TOKEN=
# 可选，站点显示名称
NEXT_PUBLIC_SITE_NAME=LunaTV
# 可选，站点对外 URL（填持久service域名）
SITE_BASE=https://lunatv-svc-xxxx.sin.unikraft.app
